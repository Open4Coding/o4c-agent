# o4c reads a .env file in the directory it starts in. Copy this to .env and fill in what you use.

# Key for your own server (llama.cpp --api-key, or any OpenAI-compatible endpoint that wants one).
# Leave it out if the server has no key. /setup can save it for you instead.
O4C_LOCAL_API_KEY=

# Claude, if you use it (--provider anthropic).
ANTHROPIC_API_KEY=sk-ant-...

# Editor for Ctrl+G and other "write it in your editor" actions (falls back to VISUAL / EDITOR).
# O4C_EDITOR=code --wait
